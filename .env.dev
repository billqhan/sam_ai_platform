#############################################
# Environment Configuration - Development   #
# Reduced for UI + Java API only            #
#############################################

# Core Project Configuration
export BUCKET_PREFIX="dev"
export ENVIRONMENT="dev"
export REGION="us-east-1"

# UI Bucket (used for S3 + CloudFront deployments)
export UI_BUCKET="${BUCKET_PREFIX}-sam-website-${ENVIRONMENT}"

# CloudFront (optional: will be set automatically if created)
export CLOUDFRONT_ID=""

# Java API (ECS access variables)
export JAVA_API_HOST=""            # Set if you need direct host access
export JAVA_API_PORT="8080"
export JAVA_API_URL=""             # Optionally set once service public IP is known

# Company Information (retain if used in UI or reports)
export COMPANY_NAME="L3Harris"
export COMPANY_CONTACT="bill.han@l3harris.com"

# Bedrock / AI Configuration (retain if still needed)
export KNOWLEDGE_BASE_ID=""
export MODEL_ID_DESC="amazon.nova-pro-v1:0"
export MODEL_ID_MATCH="amazon.nova-pro-v1:0"
export BEDROCK_REGION="us-east-1"

# AWS CLI Configuration
export AWS_PAGER=""
export AWS_DEFAULT_REGION="${REGION}"

# EKS / Helm (optional deployment path)
export EKS_CLUSTER_NAME="rfp-dev-cluster"
export EKS_NAMESPACE="rfp"
export EKS_USE_FARGATE="true"
export IMAGE_TAG="latest"
export HELM_RELEASE_NAME="rfp-java-api"
export HELM_CHART_PATH="charts/rfp-java-api"

# UI Configuration (Vite) - environment values consumed by build
VITE_API_URL=""          # Set to Java API external URL if needed
VITE_AWS_REGION="us-east-1"
VITE_ENVIRONMENT="dev"

# Removed: All Lambda, SQS, SAM.gov API, API Gateway, workflow, notification and reporting variables.
# If any remaining component depends on them, reintroduce selectively rather than restoring entire block.

